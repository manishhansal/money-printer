# ─────────────────────────────────────────────────────────────────────────────
# MoneyPrinter CloudEngine — environment variables
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env with real credentials to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL — connection string (used by TypeORM DataSource & NestJS module)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Matches the credentials in docker-compose.yml for zero-config local dev.
DATABASE_URL=postgresql://moneyprinter:moneyprinter_dev@localhost:5432/moneyprinter

# Set to "true" when connecting to a managed PostgreSQL instance that requires TLS
DATABASE_SSL=false

# Individual PostgreSQL variables (alternative to DATABASE_URL; some tooling prefers these)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=moneyprinter
POSTGRES_USER=moneyprinter
POSTGRES_PASSWORD=moneyprinter_dev

# ── Redis — connection string (canonical reference for REDIS_URL)
# Format: redis://[:<password>@]<host>:<port>[/<db>]
REDIS_URL=redis://localhost:6379

# Individual Redis variables (used by ioredis client configuration in RedisModule)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=                # leave blank for no-auth local Redis
# REDIS_DB=0                     # database index (default 0)
# REDIS_TLS=false                # set to "true" for TLS (managed Redis, e.g. ElastiCache)

# ── Multi-Agent Intelligence Engine (Phase 3-4) ──────────────────────────────
# LLM provider for multi-agent research workflows.
# Set to "disabled" to use rule-based analysis only (no API costs, fully local).
# Options: openai | anthropic | disabled
LLM_PROVIDER=disabled
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.3

# API keys — required only when LLM_PROVIDER is not "disabled"
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Local Monitoring & Watchdog (Phase 16) ────────────────────────────────────
# Watchdog health check interval in milliseconds (default: 30000 = 30 seconds)
# WATCHDOG_HEALTH_CHECK_INTERVAL_MS=30000
# Whether to enable safe auto-remediation (default: true)
# WATCHDOG_AUTO_REMEDIATION_ENABLED=true
